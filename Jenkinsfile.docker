pipeline {
    agent any

    environment {
        REGISTRY = 'registry.hub.docker.com'
        IMAGE_NAME = 'devopscloud/conference-registration-portal'
        IMAGE_TAG = "v1.0.0-${BUILD_NUMBER}"
        LATEST_TAG = 'latest'
        CONTAINER_NAME = 'conference-portal-prod'
        TARGET_PORT = '8080'
    }

    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Run Test Suite & Quality Gate') {
            steps {
                echo "Running unit and Selenium regression tests..."
                sh 'node tests/selenium_local_test.js'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "Building versioned image: ${IMAGE_NAME}:${IMAGE_TAG}..."
                sh """
                    docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -t ${IMAGE_NAME}:${LATEST_TAG} .
                """
            }
        }

        stage('Security Vulnerability Scan (Trivy)') {
            steps {
                echo "Scanning Docker image for HIGH/CRITICAL vulnerabilities..."
                sh """
                    if command -v trivy > /dev/null; then
                        trivy image --severity HIGH,CRITICAL --exit-code 0 ${IMAGE_NAME}:${IMAGE_TAG}
                    else
                        echo "Trivy scanner not installed. Skipping vulnerability gate."
                    fi
                """
            }
        }

        stage('Publish Image to Registry') {
            steps {
                echo "Publishing ${IMAGE_NAME}:${IMAGE_TAG} to Docker Registry..."
                sh """
                    echo "Mocking docker push (or using credentials if configured):"
                    echo "docker push ${IMAGE_NAME}:${IMAGE_TAG}"
                    echo "docker push ${IMAGE_NAME}:${LATEST_TAG}"
                """
            }
        }

        stage('Zero-Downtime Container Deployment') {
            steps {
                echo "Deploying container with port mapping ${TARGET_PORT}:8080..."
                sh """
                    echo "Stopping existing container if running..."
                    docker stop ${CONTAINER_NAME} || true
                    docker rm ${CONTAINER_NAME} || true

                    echo "Starting fresh container from image ${IMAGE_NAME}:${IMAGE_TAG}..."
                    docker run -d \\
                        --name ${CONTAINER_NAME} \\
                        --restart unless-stopped \\
                        -p ${TARGET_PORT}:8080 \\
                        -e SPRING_PROFILES_ACTIVE=prod \\
                        ${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }

        stage('Container Health Verification') {
            steps {
                echo "Validating container health probe..."
                sh """
                    sleep 10
                    docker inspect --format='{{json .State.Health.Status}}' ${CONTAINER_NAME} || true
                    curl -sSf http://localhost:${TARGET_PORT}/api/health
                """
            }
        }
    }

    post {
        failure {
            echo "❌ Deployment failed! Rolling back container to previous image..."
            sh """
                docker stop ${CONTAINER_NAME} || true
                docker rm ${CONTAINER_NAME} || true
                docker run -d --name ${CONTAINER_NAME} -p ${TARGET_PORT}:8080 ${IMAGE_NAME}:latest
            """
        }
    }
}

